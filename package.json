{
  "name": "@sanity-labs/pi-mcp-events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Events protocol support for Pi",
  "license": "MIT",
  "keywords": [
    "mcp",
    "events"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "validate": "npm run check && npm test && npm run build && npm run test:pi",
    "prepare": "npm run build",
    "test:pi": "node --test --test-concurrency=1 test/pi.integration.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "delay": "7.0.0",
    "p-retry": "8.0.1",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.10.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi-contract.d.ts",
      "import": "./dist/pi-contract.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/pi-mcp-events.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  }
}
