{
  "name": "@sanity-labs/pi-mcp-events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Events delivery for Pi using poll, push, and webhooks",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "mcp",
    "events"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs",
    "test:mellon": "node scripts/test-mellon.mjs",
    "validate": "npm run check && npm test && npm run test:package",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi-contract.d.ts",
      "import": "./dist/pi-contract.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/pi-mcp-events.git"
  }
}
