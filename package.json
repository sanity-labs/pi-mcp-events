{
  "name": "@sanity-labs/pi-mcp-events",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP Events protocol support for Pi",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "mcp",
    "events"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev:weather": "node dev/weather-server.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "validate": "npm run lint && npm run check && npm test && npm run build && npm run test:pi",
    "prepare": "npm run build",
    "test:pi": "node --test --test-concurrency=1 test/*.integration.mjs",
    "lint": "eslint . --max-warnings=0",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "delay": "7.0.0",
    "p-retry": "8.0.1",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi-contract.d.ts",
      "import": "./dist/pi-contract.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/pi-mcp-events.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "video": "https://cdn.sanity.io/media-libraries/al34RQcBfuD7/videos/7ef17ab43f3386c047e687ad54d3ba978df099c6.mp4"
  },
  "homepage": "https://github.com/sanity-labs/pi-mcp-events#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/pi-mcp-events/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    }
  }
}
